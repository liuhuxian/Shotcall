__pycache__/
*.py[cod]
.venv/
venv/

# ---- 密钥与本地配置 ----
.env
.env.*

# ---- 媒体（不把成片/候选推上仓库）----
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.jpg
*.jpeg
*.png

