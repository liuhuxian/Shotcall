# ---- 运行时状态：决策、任务、候选素材（属于具体项目，不入库）----
workbench/run/
workbench/build/
workbench/archive/

# ---- 批次单：每部剧不同 ----
workbench/batches/*.md
!workbench/batches/.gitkeep

# ---- 界面构建产物：用 python3 workbench/build_ui.py 生成 ----
workbench/ui/index.html

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 密钥与本地配置 ----
.env
.env.*

# ---- 媒体（不把成片/候选推上仓库）----
*.mp4
*.mov
*.webm
*.mkv
*.wav
*.mp3
*.jpg
*.jpeg
*.png

# 文档里允许放截图
!docs/**/*.png

# ---- 系统 ----
.DS_Store
Thumbs.db
